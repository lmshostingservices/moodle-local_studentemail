<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/studentemail/db" VERSION="20260626" COMMENT="XMLDB file for local_studentemail"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_studentemail_accounts" COMMENT="Tracks provisioned cPanel email accounts for Moodle students">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"        TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="FK to mdl_user.id"/>
        <FIELD NAME="email"         TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Full provisioned email address"/>
        <FIELD NAME="emailpassword" TYPE="char" LENGTH="512" NOTNULL="false" SEQUENCE="false" COMMENT="AES-256-CBC encrypted mailbox password"/>
        <FIELD NAME="studentnumber" TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Auto-assigned sequential number (autonumber format only)"/>
        <FIELD NAME="status"        TYPE="char" LENGTH="20"  NOTNULL="true"  DEFAULT="pending" SEQUENCE="false" COMMENT="active|suspended|archived|pending|error"/>
        <FIELD NAME="quota_mb"      TYPE="int"  LENGTH="10" NOTNULL="false"  DEFAULT="1024" SEQUENCE="false" COMMENT="Mailbox quota in MB"/>
        <FIELD NAME="notes"         TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Error messages or admin notes"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10" NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified"  TYPE="int"  LENGTH="10" NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"    TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid_fk"  TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_idx"  UNIQUE="true"  FIELDS="userid"/>
        <INDEX NAME="status_idx"  UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="email_idx"   UNIQUE="true"  FIELDS="email"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
